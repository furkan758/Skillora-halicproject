# Copy to .env. Use the server and database shown in SSMS.
SQL_SERVER=(localdb)\SkilloraBackend
SQL_DATABASE=Skillora
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_AUTH=windows
SQL_USERNAME=
SQL_PASSWORD=
# LocalDB uses a local pipe and does not support negotiated TLS.
# For a network SQL Server use SQL_ENCRYPT=yes and a trusted certificate.
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=5
SQL_QUERY_TIMEOUT=15
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000

